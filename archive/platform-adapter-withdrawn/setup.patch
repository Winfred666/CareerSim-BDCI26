+def configure_silent_team(data: dict, manifest: dict, skills_dir: Path | None) -> None:
+    """Opt-in team-only rail; ordinary submissions retain their normal output."""
+    enabled = manifest.get("silent_team") is True
+    rail_relative = ("observe-decide-review/scripts/silent-team.py" if manifest.get("native_teammates")
+                     else "observe-decide-review/workflows/silent-rail.py")
+    rail_path = skills_dir / rail_relative if skills_dir else None
+    if enabled and (rail_path is None or not rail_path.is_file()):
+        raise ValueError("silent_team requires the installed runtime rail")
+    top_agents = data.get("agents") or {}
+    for team in ((data.get("modes") or {}).get("team") or {}).values():
+        if not isinstance(team, dict):
+            continue
+        if manifest.get("native_teammates"):
+            team["enable_swarmflow"] = False
+            team.pop("swarmflow_concurrency", None)
+            team["dispatch_mode"] = "scheduled"
+            team["enable_hitt"] = False
+            team["enable_task_verification"] = False
+        agents = team.get("agents") or {}
+        if enabled:
+            agents = deepcopy(agents)
+            agents.setdefault("leader", {})
+            agents.setdefault("teammate", {})
+            team["agents"] = agents
+        for role, spec in list(agents.items()):
+            if enabled and isinstance(spec, str) and spec.startswith("$"):
+                spec = deepcopy(top_agents.get(spec[1:], {}))
+                agents[role] = spec
+            if not isinstance(spec, dict):
+                continue
+            rails = list(spec.get("rails") or [])
+            kept = [r for r in rails if not (isinstance(r, dict)
+                    and r.get("type") == "harness.rail.file"
+                    and (r.get("params") or {}).get("class_name") == "SilentTeamRail")]
+            previous = next(((r.get("params") or {}).get("restore", {}) for r in rails
+                             if isinstance(r, dict) and (r.get("params") or {}).get("class_name") == "SilentTeamRail"), {})
+            for key, old in previous.items():
+                if old["present"]:
+                    spec[key] = old["value"]
+                else:
+                    spec.pop(key, None)
+            if enabled:
+                restore = {}
+                lean = manifest.get("lean_team") is True
+                if lean:
+                    settings = {"prompt_mode": "minimal", "enable_task_loop": False,
+                                "enable_task_planning": False, "max_iterations": 10000 if role == "leader" else 256}
+                    restore = {key: {"present": key in spec, "value": spec.get(key)} for key in settings}
+                    spec.update(settings)
+                kept.append({"type": "harness.rail.file", "params": {
+                    "file_path": str(rail_path.resolve()), "class_name": "SilentTeamRail",
+                    "role": "leader" if role == "leader" else "worker", "lean": lean, "restore": restore}})
+            if enabled or kept != rails:
+                spec["rails"] = kept
+
+
